# ─────────────────────────────────────────────────────────────────────────────
# aprovaRH · variáveis de ambiente
# Copie para .env e preencha. O .env NUNCA vai para o GitHub.
# Configurações marcadas com (tela) também podem ser ajustadas em Integração;
# a prioridade é Banco > .env > padrão.
# ─────────────────────────────────────────────────────────────────────────────

# Ambiente: development | production
NODE_ENV=production
# Porta interna da API (o Nginx da VPS encaminha para ela). Escolha uma porta livre na VPS compartilhada.
PORT=
# Endereço público do aprovaRH, com https:// (A definir)
APP_URL=
# Banco PostgreSQL próprio do aprovaRH (não use o banco de outro projeto)
DATABASE_URL=postgresql://aprovarh:SENHA@127.0.0.1:5432/aprovarh_db

# Chave mestra de criptografia (AES-256-GCM). 64 caracteres hexadecimais.
# Gere com:  openssl rand -hex 32
# Guarde uma cópia em local seguro: sem ela, segredos e arquivos cifrados não podem ser lidos.
SETTINGS_ENCRYPTION_KEY=

# E-mails que viram perfil Desenvolvedor (setor TI), separados por vírgula
DEVELOPER_EMAILS=
# Administrador inicial ("usuário fantasma"): só para o primeiro acesso e para cadastrar o desenvolvedor.
# A senha precisa ter 10+ caracteres com letras e números e deve ser trocada no primeiro login.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Segurança (tela)
SESSION_TTL_HOURS=8
LOCK_IDLE_MINUTES=10
PIN_MAX_ATTEMPTS=5

# E-mail SMTP (tela). Enquanto não estiver configurado, vale o modo de configuração inicial:
# só o desenvolvedor e o administrador inicial entram, sem 2FA.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Pasta dos arquivos cifrados (currículos e fotos, a partir da etapa 3). Fora da pasta pública.
STORAGE_DIR=./storage
# Quantos proxies existem na frente do Node (Nginx = 1). Necessário para registrar o IP real.
TRUST_PROXY=1
